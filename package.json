{
  "name": "agentic-buyer-app",
  "version": "0.0.1",
  "private": true,
  "description": "Приложение агента покупателя с экранами сделки; ядро — agentic-buyer-ref",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && eslint .",
    "scan:secrets": "python3 .claude/hooks/scan_secrets.py .",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "demo": "tsx src/demo/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "agentic-buyer-ref": "git+https://github.com/kuzin4u/agentic-buyer-ref.git#4a4ee7c",
    "agentic-ps-platform": "git+https://github.com/kuzin4u/agentic-ps-platform.git#v0.43.0",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
