{
  // Клиент каркаса (`src/ui-client/`) — браузерная среда и сборка Vite, а не Node (решение П4 п. 4; расхождение № 3).
  // Корневой `tsconfig.json` собран под Node (`module: NodeNext`, без `DOM`), и клиент под ним не проверить.
  // Этот файл читают редактор, инструменты Svelte **и** `npm run check` (а значит и CI): замечание № 2 ревью К1 —
  // пока конфигурацию никто не вызывал, код клиента не проверялся типами нигде. В корневых конфигурациях каталог
  // клиента по-прежнему исключён: там `module: NodeNext` и нет `DOM`, и `tsc` спотыкается об импорт `.svelte`.
  //
  // **Чего эта проверка не даёт:** `App.svelte` в программу `tsc` не входит — разметка типами не покрыта (находка
  // ревью К4 № 15). Поэтому логику выносят в `view.ts` и `api.ts`, а не держат в разметке; полное покрытие разметки
  // требует `svelte-check`, то есть новой зависимости, а это решение владельца.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "rootDir": "."
  },
  // `exclude` наследуется от корневого конфига, а там каталог клиента исключён — без этой строки `include` ниже гасится
  // наследованным исключением и `tsc` отвечает «No inputs were found» (TS18003).
  "exclude": [],
  "include": ["src/ui-client"]
}
